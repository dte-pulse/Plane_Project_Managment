{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Multiple office users can share one client IP behind NAT. Keep a high
	# static-asset limit so a full app load and concurrent users do not collide.
	rate_limit {
		zone static {
			key {client_ip}
			events 5000
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
