DEBUG=0
CORS_ALLOWED_ORIGINS=https://plane.pulsepharma.net:51028

# External PostgreSQL. Do not commit the real URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=replace-with-the-rabbitmq-password-from-root.env
RABBITMQ_VHOST=plane

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-rotated-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-rotated-aws-secret-key
AWS_S3_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=contenet
USE_MINIO=0
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

WEB_URL=https://plane.pulsepharma.net:51028
ADMIN_BASE_URL=https://plane.pulsepharma.net:51028
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://plane.pulsepharma.net:51028
SPACE_BASE_PATH=/spaces
APP_BASE_URL=https://plane.pulsepharma.net:51028
APP_BASE_PATH=
LIVE_BASE_URL=https://plane.pulsepharma.net:51028
LIVE_BASE_PATH=/live

GUNICORN_WORKERS=2
LIVE_SERVER_SECRET_KEY=replace-with-a-new-live-secret
SECRET_KEY=replace-with-a-new-django-secret
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT=60/minute
