DEBUG=0
CORS_ALLOWED_ORIGINS=https://plane.pulsepharma.net:51026

# External PostgreSQL. Do not commit the real URL.
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE?sslmode=require

REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=replace-with-the-rabbitmq-default-pass-from-root.env
RABBITMQ_VHOST=plane

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-rotated-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-rotated-aws-secret-key
AWS_S3_BUCKET_NAME=hrappmodule
USE_MINIO=0
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600

WEB_URL=https://plane.pulsepharma.net:51026
ADMIN_BASE_URL=https://plane.pulsepharma.net:51026
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://plane.pulsepharma.net:51026
SPACE_BASE_PATH=/spaces
APP_BASE_URL=https://plane.pulsepharma.net:51026
APP_BASE_PATH=
LIVE_BASE_URL=https://plane.pulsepharma.net:51026
LIVE_BASE_PATH=/live

GUNICORN_WORKERS=2
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=notifications@pulsepharma.net
EMAIL_HOST_PASSWORD=replace-with-office365-app-password
EMAIL_FROM=notifications@pulsepharma.net
ENABLE_SMTP=1
LIVE_SERVER_SECRET_KEY=replace-with-the-same-live-secret-as-live.env
SECRET_KEY=replace-with-a-new-django-secret
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT=60/minute
