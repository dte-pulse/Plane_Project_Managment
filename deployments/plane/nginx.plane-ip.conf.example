# Temporary HTTP-only access for the office network using the server IP.
# Replace the IP if the server receives a different address.
server {
    listen 80;
    server_name 192.168.0.113;

    # The server address is on the office LAN; allow that subnet and local probes only.
    allow 127.0.0.1;
    allow 192.168.0.0/24;
    deny all;

    client_max_body_size 5M;

    location / {
        proxy_pass http://127.0.0.1:8106;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
