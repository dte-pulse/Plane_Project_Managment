POSTGRES_USER=plane
POSTGRES_PASSWORD=replace-with-a-strong-rabbitmq-password
POSTGRES_DB=plane
PGDATA=/var/lib/postgresql/data

RABBITMQ_USER=plane
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
RABBITMQ_VHOST=plane

# These values are used for Compose interpolation and proxy routing only.
# The API uses AWS S3 when USE_MINIO=0 in api.env.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-rotated-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-rotated-aws-secret-key
AWS_S3_BUCKET_NAME=contenet

FILE_SIZE_LIMIT=5242880
